generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")          // pooled connection
  directUrl = env("DIRECT_DATABASE_URL")  // direct connection
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  memories  Memory[]
}

model Memory {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String?
  date        DateTime @default(now())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
}

model TimelineEvent {
  id          Int    @id @default(autoincrement())
  title       String
  date        String
  description String
  imageUrl    String?
}

model LoveNote {
  id      Int    @id @default(autoincrement())
  message String
  author  String
  date    String
  color   String
}

model Photo {
  id        Int      @id @default(autoincrement())
  caption   String
  imageUrl  String
  createdAt DateTime @default(now())
}
